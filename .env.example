JWT_SECRET=coloquesua-chave-secreta-aqui
PORT=3000
SEED_DATA=false
LOG_LEVEL=info
# false apenas em K8s (migrations rodam via Job dedicado); local mantenha true.
RUN_MIGRATIONS_ON_BOOT=true

DB_USER=oficina
DB_PASS=oficina123
DB_NAME=oficina_os_db

DATABASE_URL="postgresql://oficina:oficina123@localhost:5433/oficina_os_db"

# Saga (SNS/SQS FIFO, ver oficina-messaging-infra). Vazio = publisher no-op
# e consumidor desabilitado - ok para desenvolvimento local sem AWS.
SAGA_TOPIC_ARN=
SAGA_QUEUE_URL=
AWS_REGION=us-east-1
